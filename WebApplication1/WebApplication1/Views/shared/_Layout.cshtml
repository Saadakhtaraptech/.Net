<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - WebApplication1</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar CSS */
        .navbar {
            background-color: #172554;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-size: 25px;
            font-weight: bold;
            text-decoration: none;
        }

        .navbar ul {
            list-style: none;
            display: flex;
            gap: 25px;
        }

        .navbar ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            transition: 0.3s;
        }

        .navbar ul li a:hover {
            color: #38bdf8;
        }

        /* Main Content CSS */
        .main-content {
            flex: 1;
            padding: 40px 7%;
            min-height: 400px;
        }

        /* Footer CSS */
        .footer {
            background-color: #172554;
            color: white;
            text-align: center;
            padding: 25px;
            margin-top: auto;
        }

        .footer p {
            margin: 5px;
            font-size: 14px;
        }

        /* Responsive CSS */
        @@media (max-width: 600px) {
            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            .navbar ul {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">

        <a href="/" class="logo">MyWebsite</a>

        <ul>
            <li><a href="/Home/Index">Home</a></li>
            <li><a href="/Home/About">About</a></li>
            <li><a href="/Home/Services">Services</a></li>
            <li><a href="/Home/Contact">Contact</a></li>
        </ul>

    </nav>

    <!-- Main Body -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p>© 2026 MyWebsite. All Rights Reserved.</p>
        <p>Designed with ASP.NET Core MVC</p>
    </footer>

</body>
</html>
